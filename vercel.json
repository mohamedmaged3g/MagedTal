{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/privacy", "destination": "/api/index" },
    { "source": "/data-deletion", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|src/assets/|favicon\\.svg|apple-touch-icon\\.png|pwa-.*\\.png|manifest\\.webmanifest|sw\\.js|workbox-.*\\.js|privacy|data-deletion).*)", "destination": "/index.html" }
  ]
}
