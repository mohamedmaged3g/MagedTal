# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for Facebook Messenger Webhook callback URL and self-referential links.
APP_URL="MY_APP_URL"

# Facebook Page & Messenger Graph API Configuration (Optional for live Messenger sync)
# Configure these in the AI Studio Secrets panel to enable real-time Facebook Inbox sync.
FB_PAGE_ID="61596916040640"
FB_PAGE_ACCESS_TOKEN=""
FB_VERIFY_TOKEN="aluminum_workshop_webhook_verify"
